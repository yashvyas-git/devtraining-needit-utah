        <api_name>x_58872_needit.validateEmailAddress</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description>On demand Script Include to validate email address synta using regular expressions.</description>
        <mobile_callable>false</mobile_callable>
        <name>validateEmailAddress</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[function validateEmailAddress(emailStr){
	//Use JS coercion to guarantee emailStr is a string
	emailStr = emailStr + '';

	//Compare emailStr against the allowed syntax as specified in the regular expression
	// If emailStr has allowed synatx, return true, else return false
	if(emailStr.match(/^(([^<>()\[\]\\.,;:\s@"]+(\.[^<>()\[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/)){
		return true;
	} else {
		return false;
	}
}]]></script>
